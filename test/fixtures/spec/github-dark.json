	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": {
				"foreground": "fg-muted"
			}
		},
		{
			"scope": [
				"constant",
				"entity.name.constant",
				"variable.other.constant",
				"variable.other.enummember",
				"variable.language"
			],
			"settings": {
				"foreground": "blue"
			}
		},
		{
			"scope": [
				"entity",
				"entity.name"
			],
			"settings": {
				"foreground": "purple"
			}
		},
		{
			"scope": "variable.parameter.function",
			"settings": {
				"foreground": "fg"
			}
		},
		{
			"scope": "entity.name.tag",
			"settings": {
				"foreground": "green"
			}
		},
		{
			"scope": "keyword",
			"settings": {
				"foreground": "red"
			}
		},
		{
			"scope": [
				"storage",
				"storage.type"
			],
			"settings": {
				"foreground": "red"
			}
		},
		{
			"scope": [
				"storage.modifier.package",
				"storage.modifier.import",
				"storage.type.java"
			],
			"settings": {
				"foreground": "fg"
			}
		},
		{
			"scope": [
				"string",
				"punctuation.definition.string",
				"string punctuation.section.embedded source"
			],
			"settings": {
				"foreground": "blue.d9"
			}
		},
		{
			"scope": "support",
			"settings": {
				"foreground": "blue"
			}
		},
		{
			"scope": "meta.property-name",
			"settings": {
				"foreground": "blue"
			}
		},
		{
			"scope": "variable",
			"settings": {
				"foreground": "orange"
			}
		},
		{
			"scope": "variable.other",
