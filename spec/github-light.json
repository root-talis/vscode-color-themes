			"settings": {
				"foreground": "bg-soft",
				"background": "blue"
			}
		},
		{
			"scope": "meta.diff.range",
			"settings": {
				"foreground": "purple",
				"fontStyle": "bold"
			}
		},
		{
			"scope": "meta.diff.header",
			"settings": {
				"foreground": "blue"
			}
		},
		{
			"scope": "meta.separator",
			"settings": {
				"foreground": "blue",
				"fontStyle": "bold"
			}
		},
		{
			"scope": "meta.output",
			"settings": {
				"foreground": "blue"
			}
		},
		{
			"scope": [
				"brackethighlighter.tag",
				"brackethighlighter.curly",
				"brackethighlighter.round",
				"brackethighlighter.square",
				"brackethighlighter.angle",
				"brackethighlighter.quote"
			],
			"settings": {
				"foreground": "fg-muted.d7"
			}
		},
		{
			"scope": "brackethighlighter.unmatched",
			"settings": {
				"foreground": "red.d6"
			}
		},
		{
			"scope": [
				"constant.other.reference.link",
				"string.other.link"
			],
			"settings": {
				"foreground": "fg.d5",
				"fontStyle": "underline"
			}
		},
		{
			"scope": "token.info-token",
			"settings": {
				"foreground": "blue.d6"
			}
		},
		{
			"scope": "token.warn-token",
			"settings": {
				"foreground": "green.d9"
			}
		},
		{
			"scope": "token.error-token",
			"settings": {
				"foreground": "red.d10"
			}
		},
		{
			"scope": "token.debug-token",
			"settings": {
				"foreground": "purple.d0"
			}
		}
	],
	"semanticTokenColors": {
		"string": "green",
