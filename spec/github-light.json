	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": {
				"foreground": "fg-muted"
			}
		},
		{
			"scope": [
				"constant",
				"entity.name.constant",
				"variable.other.constant",
				"variable.other.enummember",
				"variable.language"
			],
			"settings": {
				"foreground": "blue"
			}
		},
		{
			"scope": [
				"entity",
				"entity.name"
			],
			"settings": {
				"foreground": "purple"
			}
		},
		{
			"scope": "variable.parameter.function",
			"settings": {
				"foreground": "fg"
			}
		},
		{
			"scope": "entity.name.tag",
			"settings": {
				"foreground": "green"
			}
		},
		{
			"scope": "keyword",
			"settings": {
				"foreground": "red"
			}
		},
		{
			"scope": [
				"storage",
				"storage.type"
			],
			"settings": {
				"foreground": "red"
			}
		},
		{
			"scope": [
				"storage.modifier.package",
				"storage.modifier.import",
				"storage.type.java"
			],
			"settings": {
				"foreground": "fg"
			}
		},
		{
			"scope": [
				"string",
				"punctuation.definition.string",
				"string punctuation.section.embedded source"
			],
			"settings": {
				"foreground": "fg.d2"
			}
		},
		{
			"scope": "support",
			"settings": {
				"foreground": "blue"
			}
		},
		{
			"scope": "meta.property-name",
			"settings": {
				"foreground": "blue"
			}
		},
		{
			"scope": "variable",
			"settings": {
				"foreground": "orange"
			}
		},
		{
			"scope": "variable.other",
			"settings": {
				"foreground": "fg"
			}
		},
		{
			"scope": "invalid.broken",
			"settings": {
				"foreground": "red.d0",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "invalid.deprecated",
			"settings": {
				"foreground": "red.d1",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "invalid.illegal",
			"settings": {
				"foreground": "red.d2",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "invalid.unimplemented",
			"settings": {
				"foreground": "red.d3",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "carriage-return",
			"settings": {
				"foreground": "bg-muted",
				"background": "red",
				"fontStyle": "italic underline"
			}
		},
		{
			"scope": "message.error",
			"settings": {
				"foreground": "red.d4"
			}
		},
		{
			"scope": "string variable",
			"settings": {
				"foreground": "blue"
			}
		},
		{
			"scope": [
				"source.regexp",
				"string.regexp"
